{
  "meta": {
    "version": 1
  },
  "mem": {
    "model_params": {
      "kind": "dict",
      "ctrl": {
        "type": "para"
      },
      "value": {
        "model": {
          "kind": "str",
          "value": "deepseek-flash"
        }
      }
    },
    "lib": {
      "kind": "dict",
      "meta": "内核授予用户态对话的共享库（security.roots 里的 lib 根）",
      "value": {
        "greeting": {
          "kind": "str",
          "value": "hello from lib"
        }
      }
    },
    "programs": {
      "kind": "dict",
      "value": {
        "kernel_init": {
          "kind": "dict",
          "meta": "内核态初始化程序：用 create_cmd 创建用户态工作对话",
          "ctrl": {
            "type": "settingup"
          },
          "value": {
            "content": {
              "kind": "str",
              "value": "你是内核态初始化对话。你的职责是建立权限层：用 create_cmd 创建用户态工作对话（system_ref 指向 $MEM.programs.worker），把任务写进 user 消息或之后用 send_instruction 投递。你持有 $MEM 根与全部工具；用户态工作对话只持有 $work 与 $lib。"
            }
          }
        },
        "worker": {
          "kind": "dict",
          "meta": "用户态工作程序：只有工作空间与共享库，工具面收窄",
          "ctrl": {
            "type": "settingup"
          },
          "value": {
            "content": {
              "kind": "str",
              "value": "你是用户态工作对话。你的根只有 $work（你的私有工作空间）与 $lib（共享库，只读使用）。$MEM、其他对话的根、内核设备都不可见。用 $work 存放你的工作数据。"
            },
            "caps": {
              "kind": "dict",
              "value": {
                "mode": {
                  "kind": "str",
                  "value": "user"
                },
                "roots": {
                  "kind": "list",
                  "value": [
                    {
                      "kind": "str",
                      "value": "lib"
                    }
                  ]
                },
                "tools": {
                  "kind": "list",
                  "value": [
                    {
                      "kind": "str",
                      "value": "memory_read"
                    },
                    {
                      "kind": "str",
                      "value": "memory_write"
                    },
                    {
                      "kind": "str",
                      "value": "memory_make"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "init_prompt": {
      "kind": "str",
      "value": "开始：创建两个用户态工作对话，第一个负责整理 $lib，第二个负责在工作空间里记一条结果。"
    }
  },
  "security": {
    "roots": {
      "lib": "$MEM.lib"
    },
    "workspace_region": "$MEM.workspaces"
  },
  "para_ref": "$MEM.model_params",
  "init": {
    "name": "init",
    "system_ref": "$MEM.programs.kernel_init",
    "user_ref": "$MEM.init_prompt"
  }
}
